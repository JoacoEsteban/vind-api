<div>
  <div class="font-made_tommy text-white w-full max-w-[400px] md:max-w-[700px] lg:max-w-[1100px] mx-auto flex flex-col gap-y-12 md:gap-y-24 justify-center my-24 md:my-32">
    <h1 class="text-center main">
      Resources
    </h1>
    <div class="flex flex-col gap-12">
      <%= for post <- @posts do %>
        <a class="flex max-md:flex-col max-md:items-center gap-5 md:gap-10 px-5" href={post.url}>
          <div class="w-[min(200px,100%)] h-[120px] md:size-[150px] rounded-xl shrink-0">
            <img
              decoding="async"
              src={post.front_matter[:hero_img]}
              alt="Vind splash"
              class="block w-full h-full object-cover rounded-[inherit]"
            />
          </div>
          <div
            class="flex flex-col gap-3 justify-between py-2"
            data-framer-name="Post"
            name="Post"
          >
            <h2 class="text-2xl md:text-4xl font-regular" data-styles-preset="wNwFC3QmK">
              <%= post.front_matter[:title] %>
            </h2>
            <h3 class="text-lg md:text-2xl text-neutral-400 !font-normal">
              <%= post.front_matter[:description] %>
            </h3>
            <p class="text-neutral-400">
              <%= pretty_date(post.front_matter[:date]) %>
            </p>
          </div>
        </a>
      <% end %>
    </div>
  </div>
</div>
