<main class="blog-post px-4 py-20 sm:px-6 lg:px-8">
  <.flash_group flash={@flash} />
  <div class="mx-auto max-w-2xl prose dark:prose-invert">
    <h1 class="main">
      <%= @title %>
    </h1>
    <h2 class="description-heading">
      <%= @description %>
    </h2>
    <p class="text-center">
      <%= pretty_date(@date) %>
    </p>

    <div style="
    border-radius: 10px;
    margin: 0 auto;
    height: 250px;
    min-height: 100px;
    width: 90%;">
      <img
        decoding="async"
        sizes="min((100vw - 40px) * 0.8, 700px)"
        src={@hero_img}
        style="display: block; width: 100%; height: 100%; border-radius: inherit; object-position: center center; object-fit: cover; image-rendering: auto;"
      />
    </div>
    <article class="mt-8">
      <%= @inner_content %>
    </article>
  </div>
</main>

<.install_vind_banner />
