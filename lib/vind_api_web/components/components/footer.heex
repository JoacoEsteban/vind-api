  <div style="opacity: 1;" class="flex gap-5">
    <a
      href="https://github.com/joacoesteban/vind"
      target="_blank"
      rel="noopener"
      style="opacity: 0.5;"
    >
      <div
        role="img"
        aria-label="Vind Github Repository link"
        style="image-rendering: pixelated; flex-shrink: 0; fill: transparent; color: transparent; opacity: 1;"
