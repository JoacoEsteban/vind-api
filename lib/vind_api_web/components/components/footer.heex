  style="background: radial-gradient(86% 86% at 50% 136.8%, rgb(54, 54, 54) 0%, rgb(0, 0, 0) 100%); width: 100%; opacity: 1;"
>
  <div style="opacity: 1;">
    <a
      data-highlight="true"
      href="../"
      tabindex="0"
      style="height: 100%; width: 100%; opacity: 1;"
    >
      <div style="opacity: 1; width: 50px;">
        <img
          decoding="async"
          src="https://framerusercontent.com/images/yEl6Q4w0E6Jc6Hg7uvScqHUbQ.png"
          alt=""
          style="display: block; width: 100%; height: 100%; border-radius: inherit; object-position: center center; object-fit: cover; image-rendering: auto;"
        />
      </div>
    </a>
  </div>
  <div
    style="opacity: 0.5;"
    class="flex gap-2 sm:gap-8 max-sm:flex-col items-center justify-center"
  >
    <div style="outline: none; display: flex; flex-direction: column; justify-content: flex-start; flex-shrink: 0; --extracted-r6o4lv: rgb(255, 255, 255); transform: none; opacity: 1;">
      <p style="">
        <a
          href="https://chrome.google.com/webstore/detail/vind/ocohbenbjomofbknmcmaedadcmonedee"
          target="_blank"
          rel="noopener"
        >
          Chrome
        </a>
      </p>
    </div>
    <div style="outline: none; display: flex; flex-direction: column; justify-content: flex-start; flex-shrink: 0; --extracted-r6o4lv: rgb(255, 255, 255); transform: none; opacity: 1;">
      <p style="">
        <a
          href="https://addons.mozilla.org/en-US/firefox/addon/vind/"
          target="_blank"
          rel="noopener"
        >
          Firefox
        </a>
      </p>
    </div>
    <div style="outline: none; display: flex; flex-direction: column; justify-content: flex-start; flex-shrink: 0; --extracted-r6o4lv: rgb(255, 255, 255); transform: none; opacity: 1;">
      <p style="">
        <a href="https://github.com/JoacoEsteban/vind/issues" target="_blank" rel="noopener">
          Issues
        </a>
      </p>
    </div>
    <div style="outline: none; display: flex; flex-direction: column; justify-content: flex-start; flex-shrink: 0; --extracted-r6o4lv: rgb(255, 255, 255); transform: none; opacity: 1;">
      <p style="">
        <a href="mailto:support@vind-works.io" target="_blank" rel="noopener">
          Help
        </a>
      </p>
